rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Personal data: only the owner can read/write
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // One document per store (v255+). Rules do not reach into
      // subcollections on their own, so this needs its own match.
      match /stores/{storeId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // What this user's AI agents read (v281+): the snapshot the app saves
      // after each sync. The agent bridge reads it with the project's own
      // service account, which these rules do not apply to.
      match /agent/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // AI agent access links (v281+). The document ID is a SHA-256 hash of the
    // link's token; the token itself is never stored. Only the owner can make,
    // see or revoke their links. The bridge checks them with the service account.
    match /agentTokens/{tokenHash} {
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasOnly(['uid', 'email', 'name', 'canWrite', 'createdAt']);
      allow read, delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // Shared data: any authenticated user can read/write
    match /shared/{docId} {
      allow read, write: if request.auth != null;

      match /stores/{storeId} {
        allow read, write: if request.auth != null;
      }
    }

    // Import inbox: a drop-off box, not live data.
    // Anyone holding the token may CREATE a batch here and nothing else.
    // They cannot read it back, change it, or delete it, and no live store
    // is reachable from here — the app pulls from this and every record
    // still goes through manual review before it lands anywhere.
    match /importInbox/{docId} {
      allow create: if request.resource.data.keys().hasAll(['token', 'payload'])
                    && request.resource.data.token == 'lns_inbox_AjxSg5BsH9hGTLxrXKTwokTuXvZ4W1zfERUPGmAf'
                    && request.resource.data.payload is string
                    && request.resource.data.payload.size() < 900000;
      allow read, delete: if request.auth != null;
      allow update: if false;
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
