rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Personal data: only the owner can read/write
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Shared data: any authenticated user can read/write
    match /shared/{docId} {
      allow read, write: if request.auth != null;
    }

    // Import inbox: a drop-off box, not live data.
    // Anyone holding the token may CREATE a batch here and nothing else.
    // They cannot read it back, change it, or delete it, and no live store
    // is reachable from here — the app pulls from this and every record
    // still goes through manual review before it lands anywhere.
    match /importInbox/{docId} {
      allow create: if request.resource.data.keys().hasAll(['token', 'payload'])
                    && request.resource.data.token == 'lns_inbox_AjxSg5BsH9hGTLxrXKTwokTuXvZ4W1zfERUPGmAf'
                    && request.resource.data.payload is string
                    && request.resource.data.payload.size() < 900000;
      allow read, delete: if request.auth != null;
      allow update: if false;
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
